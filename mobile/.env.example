EXPO_PUBLIC_ZEKRA_API_URL=https://app.zekra.dev

# ── Native Google sign-in (optional) ────────────────────────────────────────
# Without these the app signs in with Google through the API's browser flow,
# which needs nothing here. With them it uses Google's native sheet
# (src/features/social/google.ts). Values come from Google Cloud Console →
# APIs & Services → Credentials (same project as the API's web client):
#   EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID  the WEB client id — the same as the API's
#                                     OAUTH_GOOGLE_CLIENT_ID (it is the ID token's audience)
#   EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID  the iOS client id (bundle id com.fadymondy.zekra)
#   GOOGLE_IOS_URL_SCHEME             that iOS client id reversed:
#                                     com.googleusercontent.apps.<number>-<hash>
# Android needs no id here: create an Android client (package com.fadymondy.zekra +
# the signing certificates' SHA-1) and the SDK finds it by package + certificate.
# The API must accept the iOS client's tokens: add the iOS client id to
# OAUTH_GOOGLE_AUDIENCES on the server.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=
