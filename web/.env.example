# The Go API (cmd/api). /api, /graphql, /events and the install scripts are proxied to it.
API_ORIGIN=http://localhost:8080

# Mahaam Feedback: the floating "Report a problem" widget on every page, and server errors filed
# as issues in the Zekra project on Mahaam. The key is the project's public key (pfk_…); its
# allowed origins must include this app's URL. Empty = off.
MAHAAM_URL=https://console.mahaam.app
MAHAAM_FEEDBACK_KEY=
MAHAAM_APP_URL=https://app.zekra.dev   # an allowed origin, used by server-side reports
NEXT_PUBLIC_MAHAAM_URL=https://console.mahaam.app
NEXT_PUBLIC_MAHAAM_FEEDBACK_KEY=

# The hosted MCP endpoint shown on the Connect page.
NEXT_PUBLIC_MCP_URL=https://mcp.zekra.dev
