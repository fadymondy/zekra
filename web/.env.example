# The Go API (cmd/api). /api, /graphql, /events and the install scripts are proxied to it.
API_ORIGIN=http://localhost:8080

# "Report a problem": reports are filed into Zekra's project on Mahaam through its public
# embed intake. Create a feedback key on the Mahaam project (allowed origin: this app's URL)
# and paste its public key (pfk_…). Empty = the Report button is hidden.
NEXT_PUBLIC_MAHAAM_URL=https://console.mahaam.app
NEXT_PUBLIC_MAHAAM_FEEDBACK_KEY=
