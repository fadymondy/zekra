# /opt/zekra-code-index/env  — chmod 600, NEVER committed with real values.
# Consumed by zekra-code-index.service (see scripts/code-index.py).
ZEKRA_API_URL=https://app.zekra.dev
ZEKRA_TOKEN=cbt_xxx                     # brain token with write access
ZEKRA_NAMESPACE=flowos
GITHUB_TOKEN=ghp_xxx                      # read access to the private org repos
REPOMIX_CMD=/opt/zekra-code-index/node_modules/.bin/repomix
CODE_INDEX_CACHE=/opt/zekra-code-index/repos
CODE_INDEX_STATE=/opt/zekra-code-index/state.json
CODE_MAX_CHUNKS=80
DOC_MAX_CHUNKS=40
# Optional — when the brain DB is reachable, the run also writes the entity graph
# and soft-retires chunks whose files disappeared:
# ZEKRA_DSN=postgresql://zekra:***@host:5432/zekra
# FLOWOS_DSN=postgresql://flowos:***@host:5432/onestudio_hub   (READ ONLY, REPO_OF edges)
PATH=/opt/zekra-code-index/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
