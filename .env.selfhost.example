# Copy to .env.selfhost and fill in. Generate each secret with: openssl rand -hex 32
POSTGRES_PASSWORD=
AUTH_SECRET=
# 64 hex characters; keep it stable or stored secrets become unreadable.
ZEKRA_SECRETS_KEY=
MFA_CHALLENGE_SECRET=

# Public origin of the console, and the port it listens on.
APP_URL=http://localhost:3020
ZEKRA_PORT=3020

# Emails that get the admin role on sign-up (comma-separated).
ADMIN_EMAILS=
ALLOW_REGISTRATION=true

# Optional: mail (sign-in and verification codes) and Claude for brain chat.
RESEND_API_KEY=
MAIL_FROM=
ANTHROPIC_API_KEY=
