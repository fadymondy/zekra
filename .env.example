# ─── Core ────────────────────────────────────────────────────────────────
APP_ENV=development                 # development | production (production fails closed on secrets)
APP_URL=http://localhost:8080       # public base URL (OAuth/SSO callbacks)
ADDR=:8080

# ─── Database (togo-postgres) ────────────────────────────────────────────────────
# Chosen at `togo new` time. Switch later via DB_DRIVER + DATABASE_URL.
# For the docker stacks (postgres / togo-postgres / supabase / mysql / mongodb): `togo db:up`.
DB_DRIVER=pgx
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cabrain?sslmode=disable

# ─── Logging (togo-framework/log) ──────────────────────────────────────────
LOG_LEVEL=info                      # debug | info | warn | error
LOG_FORMAT=text                     # text | json
# LOG_FILE=storage/logs/app.log     # file sink (default: stderr)
# LOG_SERVICE=my-app

# ─── i18n (togo-framework/i18n) ────────────────────────────────────────────
LOCALE=en
LOCALE_DIR=lang

# ─── Cache (togo-framework/cache) ──────────────────────────────────────────
CACHE_DRIVER=memory                 # memory | file | database | redis (plugin)
# CACHE_DIR=storage/cache           # for the file driver

# ─── Storage / Realtime ────────────────────────────────────────────────────
STORAGE_DIR=storage
# REALTIME_SECRET=                  # togo-framework/realtime-ws private-channel tickets

# ─── Auth (togo-framework/auth) ────────────────────────────────────────────
AUTH_SECRET=                        # REQUIRED in production (>= 32 bytes); dev auto-generates an ephemeral one
ZEKRA_SECRETS_KEY=                # Secrets vault AES-256 key (64 hex chars). Stable across restarts so vaulted
                                    # secrets stay decryptable. If unset, derived from AUTH_SECRET; if that's also
                                    # unset the vault fails closed (never stores plaintext). Keep private, never commit.
AUTH_DRIVER=base                    # base (JWT) | supabase
AUTH_TTL_HOURS=24
AUTH_MIN_PASSWORD=8
SESSION_DRIVER=cookie               # cookie (stateless) | database | file | redis (plugin)
# SESSION_DIR=storage/sessions      # for the file session driver
COOKIE_SECURE=                      # 1 to force Secure cookies (auto-on in production)
CORS_ORIGINS=                       # comma-separated allowed origins (empty = same-origin)

# ─── Console login gate (human web console; complementary to the MCP token ACL) ─
# Off by default so local/dev + the running instance stay reachable unauthenticated.
# Set to 1 to require a valid auth session for the console admin/management endpoints
# (token CRUD, grants, brain delete, memory edit, import, session launcher, gaps
# resolve). Read-only + core memory ops stay governed by the X-Zekra-Token ACL.
ZEKRA_REQUIRE_AUTH=                # 1 | true to enforce the console login gate
DEV_LOGIN_EMAIL=dev@togo.local      # identity minted by auth-dev "Login as developer" (non-prod only)
# Admin identity options:
#   • dev:  POST /api/auth/dev/login  → one-click admin (roles=[admin], perms=[*]); disabled in production.
#   • prod: register a credentialed admin →  POST /api/auth/register {email,password}  (needs AUTH_SECRET set),
#           then sign in at the console. Secrets live in .env / ~/.env.cabrain, never in source.
#
# SHARED-DB NOTE (activation gate for login): the auth plugin stores accounts in a
# table named `users`, but the shared `cabrain` Postgres ALREADY has a `users` table
# owned by Cognee (FastAPI-Users: hashed_password/is_superuser/tenant_id). Auth's
# CREATE TABLE IF NOT EXISTS no-ops against it, so login 500s. Isolate auth into its
# own schema (additive — does NOT touch Cognee's table) then point the app's DB
# connection at it. Run once as the cabrain role (needs your authorization — modifies
# shared PG):
#     CREATE SCHEMA IF NOT EXISTS cabrain_auth;
#     CREATE TABLE IF NOT EXISTS cabrain_auth.users (
#       id text PRIMARY KEY, email text UNIQUE NOT NULL, password_hash text NOT NULL,
#       roles text NOT NULL DEFAULT '', permissions text NOT NULL DEFAULT '', created_at text NOT NULL);
# then append to the app DSN:  ?search_path=cabrain_auth,public
# (auth's users/auth_sessions/… resolve to cabrain_auth; brain's memories/… fall back
# to public; Cognee keeps its own connection/search_path untouched). Until then, leave
# ZEKRA_REQUIRE_AUTH unset — the console stays open and the app is unaffected.

# ─── Accounts (internal/account; see DEPLOY.md §2b "Auth & accounts") ──────
AUTH_PUBLIC_URL=                    # public origin for OAuth callbacks + email links, e.g. https://app.zekra.dev (falls back to APP_URL)
ADMIN_EMAILS=                       # comma-separated; these accounts get the `admin` role (or: zekractl admin <email>)
ALLOW_REGISTRATION=                 # false|0|no|off closes password sign-up and SSO account creation (default: open)
VAULT_KEY=                          # 32 bytes (64 hex or base64) sealing TOTP secrets; falls back to ZEKRA_SECRETS_KEY, then AUTH_SECRET. Set in production.
# TOTP_ISSUER=Zekra                 # name shown in authenticator apps
# AUTH_LOGIN_PATH=/login            # console sign-in page; OAuth failures land on <path>?error=<reason>
# AUTH_HOME=/                       # where an OAuth sign-in lands when no ?redirect= was given
# AUTH_ADMIN_HOME=/dashboard        # same, for admin/owner accounts

# ─── Remote MCP + OAuth 2.1 for AI agents (plugins/brain: /api/mcp, /api/oauth/*) ─
# Signed-in users connect Claude.ai / Claude Desktop / ChatGPT to THEIR brains. Brain
# access for session users comes from brain_members (creator = owner); admin/owner-role
# accounts see every brain.
MCP_PUBLIC_URL=                     # canonical MCP URL users paste, e.g. https://mcp.zekra.dev
                                    # (RFC 9728 resource + RFC 8707 token audience; also the
                                    # OAuth issuer). Empty → <AUTH_PUBLIC_URL>/api/mcp.
# ZEKRA_OAUTH_ISSUER=               # override the issuer (default MCP_PUBLIC_URL, then AUTH_PUBLIC_URL)
# ZEKRA_OAUTH_AUTHORIZE_PATH=/en/oauth/authorize  # consent page on AUTH_PUBLIC_URL (authorization_endpoint)
# ZEKRA_PUBLIC_URL=                 # REST base the local `zekra mcp` CLI is pointed at by /api/brain/session
                                    # (default AUTH_PUBLIC_URL)

# Sign in with Google (web + native ID token). Disabled (routes 404) unless ID and SECRET are set.
# Callback: <AUTH_PUBLIC_URL>/api/auth/google/callback. Aliases: GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GOOGLE_AUDIENCES=           # extra accepted ID-token audiences (native app client ids), comma-separated
# OAUTH_GOOGLE_REDIRECT_URL=        # override the callback URL
# Sign in with GitHub (OAuth App, or GitHub App with "Email addresses: read"). Aliases: GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET.
# Callback: <AUTH_PUBLIC_URL>/api/auth/github/callback
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GITHUB_REDIRECT_URL=        # override the callback URL
# GITHUB_APP_SCHEME=zekra           # native app return scheme for ?app=1 sign-ins
# Sign in with Apple. Web flow needs all four; callback <AUTH_PUBLIC_URL>/api/auth/apple/callback (https only).
# APPLE_SERVICES_ID=                # the Services ID (alias: APPLE_SERVICE_ID)
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY_PATH=           # path to the .p8 key, or
# APPLE_PRIVATE_KEY=                # the .p8 PEM inline (literal \n allowed). Never commit it.
# APPLE_BUNDLE_IDS=                 # native app bundle ids accepted as identity-token audiences
# APPLE_REDIRECT_URL=               # override the callback URL

# OAuth drivers (togo-framework/auth-oauth; its google/github entries are superseded by the above)
# OAUTH_FACEBOOK_CLIENT_ID=
# OAUTH_FACEBOOK_CLIENT_SECRET=
# Firebase (togo-framework/auth-firebase)
# FIREBASE_PROJECT_ID=
# WorkOS SSO (togo-framework/auth-workos)
# WORKOS_CLIENT_ID=
# WORKOS_API_KEY=
# WORKOS_CONNECTION=

# Supabase auth (togo-framework/plugin-auth-supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# ─── Mail (togo-framework/mail) ────────────────────────────────────────────
MAIL_DRIVER=                        # smtp | log (default: log in dev, smtp if MAIL_HOST set)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM="Zekra <no-reply@zekra.dev>"  # sender for account emails (codes, exports); must be a Resend-verified domain
MAIL_ENCRYPTION=starttls            # starttls | tls | none
RESEND_API_KEY=                     # account emails go through Resend when set (MAIL_DRIVER=resend optional).
                                    # Unset: non-production LOGS each email incl. its code; production cannot deliver codes.

# ─── Search (togo-framework/search) ────────────────────────────────────────
SEARCH_DRIVER=paradedb              # paradedb (default) | elasticsearch | opensearch
# SEARCH_URL=http://localhost:9200  # for elasticsearch/opensearch
# SEARCH_USERNAME=
# SEARCH_PASSWORD=

# ─── Workers (togo-framework/worker) ───────────────────────────────────────
WORKER_AUTOSTART=true               # set false to disable background workers

# ─── MCP / AI (togo-framework/mcp) ─────────────────────────────────────────
# TOGO_MCP_ROLE=admin               # admin | user (toolset scope; set by mcp:install)
# TOGO_AI_MODEL=                     # optional model override

# ─── Frontend (web/.env mirrors NEXT_PUBLIC_*) ─────────────────────────────
NEXT_PUBLIC_API_ORIGIN=http://localhost:8080
NEXT_PUBLIC_LOCALE=en
# NEXT_PUBLIC_TOGO_RESOURCES=posts   # dashboard admin resource list

# ═══════════════════════════════════════════════════════════════════════════
# Zekra — infra inputs (SPEC §1.5 / infra §4 bundle). Provisioned by the infra
# agent; secrets live root-owned at /mnt/c/services/cabrain/{.pg-secrets,.minio-secrets}
# and are injected into the container env — NEVER commit real values here.
# All hostnames resolve only inside Docker network `stack_stacknet`, so the app
# runs as a container on that network.
# ═══════════════════════════════════════════════════════════════════════════

# --- Postgres (togo-postgres) --- the app reads DATABASE_URL (togo.yaml: ${DATABASE_URL}).
# Infra exports ZEKRA_DATABASE_URL; map it → DATABASE_URL in the container env.
# ZEKRA_DATABASE_URL=postgresql://cabrain:<secret>@pg:5432/cabrain
ZEKRA_DB_SLEEP_ROLE=cabrain_sleep         # analytics/consolidation role (N1 isolation)

# --- Cognee engine (wrapped cognify engine) ---
COGNEE_API_URL=http://cognee:8000
# COGNEE_API_TOKEN=<secret — from .pg-secrets>
COGNEE_MCP_URL=                              # not deployed (optional per brief)

# --- TEI (self-hosted embeddings + rerank on RTX 3060) ---
TEI_EMBEDDINGS_URL=http://tei-embed:80
TEI_EMBEDDINGS_MODEL=Qwen/Qwen3-Embedding-0.6B   # 1024-dim — LOCKED (schema vector(1024))
TEI_RERANKER_URL=http://tei-rerank:80
TEI_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Extraction LLM (structured-output for the retain write-decision, §4.1) ---
EXTRACTION_LLM_PROVIDER=ollama
EXTRACTION_LLM_URL=http://ollama:11434
EXTRACTION_LLM_MODEL=mistral:7b-instruct     # placeholder → override to gpt-oss:20b once pulled
EXTRACTION_LLM_API_KEY=                       # unused for ollama
EXTRACTION_LLM_FALLBACK_BASE_URL=             # optional cheap-API fallback
EXTRACTION_LLM_FALLBACK_API_KEY=

# --- Cold tier (Iceberg/Parquet on MinIO; R2/GCS-compatible) ---
COLD_STORE_ENDPOINT=http://minio:9000
COLD_STORE_BUCKET=cabrain-cold
COLD_STORE_REGION=auto
COLD_STORE_ACCESS_KEY=cabrain-app
# COLD_STORE_SECRET_KEY=<secret — from .minio-secrets>

# --- Networking ---
ZEKRA_INTERNAL_NETWORK=stack_stacknet
ZEKRA_APP_HOSTNAME=zekra.dev   # NPM route (pending)
COGNEE_DOCS_HOSTNAME=cognee.fadymondy.com    # NPM route (pending)
