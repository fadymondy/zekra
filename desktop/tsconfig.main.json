{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "outDir": "out/main",
    "rootDir": "src/main",
    "sourceMap": true,
    "strict": true,
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"],
    // Desktop has no node_modules of its own; the type packages live in the
    // web install, same as for the renderer.
    "typeRoots": ["../web/node_modules/@types"]
  },
  "include": ["src/main/**/*.ts"]
}
