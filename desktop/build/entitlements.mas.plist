<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App Sandbox entitlements for the Mac App Store build (the main app only;
  helpers get entitlements.mas.inherit.plist). The provisioning profile
  (build/zekra-mas.provisionprofile, MAC_APP_STORE, com.fadymondy.zekra)
  must allow every identifier below.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.application-identifier</key>
  <string>JW9HJH86GC.com.fadymondy.zekra</string>
  <key>com.apple.developer.team-identifier</key>
  <string>JW9HJH86GC</string>
  <!-- Electron's helpers share Mach ports through the team-prefixed group. -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>JW9HJH86GC.com.fadymondy.zekra</string>
  </array>
  <!-- safeStorage keeps the session-token key in the Keychain. -->
  <key>keychain-access-groups</key>
  <array>
    <string>JW9HJH86GC.com.fadymondy.zekra</string>
  </array>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- The Zekra API. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Open Markdown… / exports via the open and save panels. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <!-- No Apple Events: Apple Notes import and Quick Capture "From browser"
       are off in MAS builds (process.mas, src/main/browser-tab.ts), so no
       temporary-exception entitlement for App Review to question. -->
</dict>
</plist>
