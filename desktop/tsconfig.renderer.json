{
  // Typecheck only. esbuild (build/bundle.mjs) does the emitting, and it
  // strips types WITHOUT checking them — so without this config being correct,
  // nothing checks the renderer at all.
  //
  // This file previously said `"include": ["src/renderer/*.ts"]`, which matches
  // no .tsx and nothing in a subdirectory. tsc reported "No inputs were found"
  // and exited 0, so it looked like a passing check while checking nothing.
  // The options below were also left over from the pre-React renderer
  // (module: "None", no jsx), which is why widening the include alone is not
  // enough.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    // @types also lives in the web install; tsc otherwise looks only in this
    // project's own node_modules/@types, which does not exist.
    "typeRoots": ["../web/node_modules/@types"],
    // Mirrors build/bundle.mjs:
    //   @/*       -> the web app (`alias: { "@": WEB }`). The mobile/src
    //                fallback exists only for files UNDER mobile/src, which
    //                use "@/" for their own root (e.g. "@/i18n/define"); the
    //                bundler resolves that by importer, tsc by fallback.
    //   @mobile/* -> mobile/src (shared pure-TS modules: i18n dictionaries)
    //   *         -> web/node_modules: the renderer's React/shadcn packages
    //                come from the web install, not desktop/node_modules
    // Without the second one, react, react-dom and lucide-react all read as
    // missing and every JSX tag errors.
    "paths": {
      "@/*": ["../web/*", "../mobile/src/*"],
      "@mobile/*": ["../mobile/src/*"],
      // React ships no types of its own, and the wildcard below would resolve
      // it to index.js and stop — never consulting @types. Point the typed
      // packages at their declarations explicitly, before the fallback.
      "react": ["../web/node_modules/@types/react"],
      "react/*": ["../web/node_modules/@types/react/*"],
      "react-dom": ["../web/node_modules/@types/react-dom"],
      "react-dom/*": ["../web/node_modules/@types/react-dom/*"],
      // The presentations viewers (MH-450) pull in three.js, typed the same way.
      "three": ["../web/node_modules/@types/three"],
      "three/*": ["../web/node_modules/@types/three/*"],
      "*": ["../web/node_modules/*"]
    }
  },
  // The web edits Tiptap's Storage type in types/*.d.ts; the renderer mounts the
  // same editor, so it needs the same ambient declarations.
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx", "src/shared/**/*.ts", "../web/types/**/*.d.ts"]
}
