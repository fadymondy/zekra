{
  "compilerOptions": {
    "module": "None",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "outDir": "out/renderer",
    "rootDir": "src/renderer",
    "sourceMap": true,
    "strict": true,
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/renderer/*.ts"]
}
